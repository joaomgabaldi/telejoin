# telejoin — configuração.
# Formato: CHAVE=valor, sem aspas; comentário só em linha própria.
# Precedência: variável de ambiente real > este arquivo > default no código.
# Copie para `.env` (chmod 600) e preencha.

# ---- credenciais -----------------------------------------------------------
# my.telegram.org > API development tools (as mesmas do telefuse/teleuploader).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- caminhos (relativos à raiz do projeto) --------------------------------
TELEJOIN_SESSION=telejoin.session
# Resultado de cada link. Rodar de novo pula o que já terminou.
TELEJOIN_ESTADO=telejoin.estado.json

# ---- ritmo -----------------------------------------------------------------
# Intervalo BASE entre uma entrada e a próxima (com até +50% de variação aleatória).
# Entrar em muitos chats seguidos é o que mais dispara FLOOD_WAIT.
TELEJOIN_INTERVALO_S=30
# Cada FLOOD_WAIT dobra o intervalo até este teto; cada entrada sem flood o
# reduz em 10%, de volta à base. FLOOD_WAIT em si nunca encerra a execução:
# o telejoin espera o tempo que o Telegram pedir, por maior que seja.
TELEJOIN_INTERVALO_MAX_S=900
